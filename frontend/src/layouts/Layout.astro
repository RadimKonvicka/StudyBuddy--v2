---
// Společné rozvržení všech stránek: hlavička, navigace, přepínač režimu, ochrana přihlášení.
import "../styles/global.css";
import Logo from "../components/Logo.astro";

interface Props {
  title: string;
  /** false = stránka je přístupná i bez přihlášení (login, registrace) */
  auth?: boolean;
  /** širší obsah (mapa, dashboard) */
  wide?: boolean;
}
const { title, auth = true, wide = false } = Astro.props;
const path = Astro.url.pathname;
const nav = [
  { href: "/", label: "Přehled", icon: "◎" },
  { href: "/new", label: "Nový předmět", icon: "＋" },
  { href: "/review", label: "Opakování", icon: "↻" },
];
---
<!doctype html>
<html lang="cs" data-auth={auth ? "required" : "public"}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="StudyBuddy – adaptivní studijní plán s AI agenty." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} · StudyBuddy</title>
    <!-- Spustí se před vykreslením: nastaví motiv (bez probliknutí) a pohlídá přihlášení. -->
    <script is:inline>
      (function () {
        var t = null;
        try { t = localStorage.getItem("sb_theme"); } catch (e) {}
        if (!t) t = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        document.documentElement.dataset.theme = t;
        var token = null;
        try { token = localStorage.getItem("sb_token"); } catch (e) {}
        if (document.documentElement.dataset.auth === "required" && !token) {
          location.replace("/login?next=" + encodeURIComponent(location.pathname + location.search));
        }
      })();
    </script>
  </head>
  <body class="min-h-screen">
    <div class="sky" aria-hidden="true"></div>
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 btn-primary z-50">Přeskočit na obsah</a>

    <header class="sticky top-0 z-40 border-b border-line bg-bg/80 backdrop-blur">
      <div class:list={["mx-auto px-4 h-16 flex items-center gap-4", wide ? "max-w-6xl" : "max-w-5xl"]}>
        <a href={auth ? "/" : "/login"} class="flex items-center gap-2 text-ink shrink-0">
          <Logo size={30} />
          <span class="h-display text-xl font-semibold">StudyBuddy</span>
        </a>

        {auth && (
          <nav class="hidden sm:flex items-center gap-1 ml-4" aria-label="Hlavní navigace">
            {nav.map((item) => (
              <a
                href={item.href}
                class:list={[
                  "px-3 py-2 rounded-lg text-sm font-semibold transition",
                  path === item.href ? "bg-accent-soft text-accent" : "text-muted hover:text-ink hover:bg-surface-2",
                ]}
              >{item.label}</a>
            ))}
          </nav>
        )}

        <div class="ml-auto flex items-center gap-2">
          <button id="theme-toggle" class="btn-ghost !px-3 !py-2" title="Přepnout světlý/tmavý režim (T)" aria-label="Přepnout světlý/tmavý režim">
            <span class="dark:hidden">☾</span><span class="hidden dark:inline">☀</span>
          </button>
          {auth && (
            <div class="flex items-center gap-2">
              <span id="nav-user" class="hidden md:inline text-sm text-muted"></span>
              <button id="logout" class="btn-ghost !px-3 !py-2 text-sm">Odhlásit</button>
            </div>
          )}
        </div>
      </div>
    </header>

    <main id="main" class:list={["mx-auto px-4 py-8 pb-24 sm:pb-8", wide ? "max-w-6xl" : "max-w-5xl"]}>
      <slot />
    </main>

    {/* Spodní navigace na mobilu */}
    {auth && (
      <nav class="sm:hidden fixed bottom-0 inset-x-0 z-40 border-t border-line bg-surface/95 backdrop-blur grid grid-cols-3" aria-label="Mobilní navigace">
        {nav.map((item) => (
          <a href={item.href} class:list={["py-2.5 text-center text-xs font-semibold", path === item.href ? "text-accent" : "text-muted"]}>
            <span class="block text-lg leading-none mb-0.5">{item.icon}</span>{item.label}
          </a>
        ))}
      </nav>
    )}

    <script>
      import { getUser, logout } from "../lib/auth.js";

      const root = document.documentElement;
      function toggleTheme() {
        const next = root.dataset.theme === "dark" ? "light" : "dark";
        root.dataset.theme = next;
        try { localStorage.setItem("sb_theme", next); } catch {}
      }
      document.getElementById("theme-toggle")?.addEventListener("click", toggleTheme);
      document.getElementById("logout")?.addEventListener("click", logout);

      const showUser = (u) => {
        const el = document.getElementById("nav-user");
        if (el && u) el.textContent = u.display_name;
      };
      showUser(getUser());
      window.addEventListener("sb:user", (e) => showUser(e.detail));

      // Klávesová zkratka T = přepnutí motivu (mimo psaní do formulářů)
      document.addEventListener("keydown", (e) => {
        const t = e.target;
        if (t instanceof HTMLElement && (t.isContentEditable || ["INPUT", "TEXTAREA", "SELECT"].includes(t.tagName))) return;
        if (e.key.toLowerCase() === "t" && !e.ctrlKey && !e.metaKey && !e.altKey) toggleTheme();
      });
    </script>
  </body>
</html>
