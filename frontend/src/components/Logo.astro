---
// Logo: malé souhvězdí – čtyři hvězdy spojené linkou (motiv mapy znalostí).
const { size = 32 } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 32 32" fill="none" aria-hidden="true">
  <path d="M5 23 L12 9 L20 15 L27 6" stroke="currentColor" stroke-opacity=".45" stroke-width="1.5" stroke-linecap="round" />
  <circle cx="5" cy="23" r="2.4" fill="var(--strong)" />
  <circle cx="12" cy="9" r="2.8" fill="var(--mid)" />
  <circle cx="20" cy="15" r="2.2" fill="var(--weak)" />
  <path d="M27 2.5 L28.2 5 L30.8 6 L28.2 7 L27 9.5 L25.8 7 L23.2 6 L25.8 5 Z" fill="var(--accent)" />
</svg>
