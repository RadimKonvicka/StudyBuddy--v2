---
// Přehled (dashboard). V kroku 1 jen ověří přihlášení a pozdraví; grafy a doporučení přibudou v kroku 7.
import Layout from "../layouts/Layout.astro";
---
<Layout title="Přehled" wide>
  <section class="rise">
    <p class="text-sm font-semibold uppercase tracking-widest text-accent">Tvoje obloha</p>
    <h1 class="h-display text-4xl font-semibold mt-1" id="greeting">Ahoj!</h1>
    <p class="text-muted mt-2">Tady brzy uvidíš svůj pokrok, sérii dní a co se dnes učit.</p>
  </section>

  <section class="card p-6 mt-8">
    <h2 class="h-display text-xl font-semibold mb-2">Účet</h2>
    <dl id="me" class="grid sm:grid-cols-3 gap-4 text-sm">
      <div><dt class="text-muted">Načítám…</dt></div>
    </dl>
  </section>
</Layout>

<script>
  import { api } from "../lib/api.js";
  import { updateUser } from "../lib/auth.js";
  import { esc, toast } from "../lib/dom.js";

  (async () => {
    try {
      const me = await api("/api/auth/me");
      updateUser(me);
      document.getElementById("greeting")!.textContent = `Ahoj, ${me.display_name}!`;
      document.getElementById("me")!.innerHTML = `
        <div><dt class="text-muted">E-mail</dt><dd class="font-semibold">${esc(me.email)}</dd></div>
        <div><dt class="text-muted">XP</dt><dd class="font-semibold">${me.xp}</dd></div>
        <div><dt class="text-muted">Série dní</dt><dd class="font-semibold">${me.streak}</dd></div>`;
    } catch (err) {
      toast((err as Error).message, "error");
    }
  })();
</script>
